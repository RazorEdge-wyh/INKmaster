# INKmaster 环境变量配置
# 用法：复制本文件为 backend/.env 并按需填写；未填写的项使用代码内默认值。

# --- AI 供应商 ---
# DeepSeek（默认供应商）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- 安全 ---
# 可选：Fernet 加密密钥。不设置则首次运行自动生成，并保存到 data/.inkmaster.key。
ENCRYPTION_KEY=

# --- 数据库（可选，默认 sqlite+aiosqlite:///data/inkmaster.db）---
# DATABASE_URL=sqlite+aiosqlite:///./data/inkmaster.db
